# Copy to .env and fill from Bitwarden. Never commit .env (the repo is public).
# In the cluster these come from the Kubernetes Secret `app-credentials` (not in git).
PORT=8080
ROLE=app                               # app | worker
PUBLIC_BASE_URL=https://lanyard.cnh.radarhq.io
EVENT_TZ=America/Denver
ES_URL=                                # Bitwarden: Elastic endpoint
ES_API_KEY=                            # Bitwarden: Elastic API key
VALKEY_URL=redis://localhost:6379
OPENAI_API_KEY=                        # Bitwarden: OpenAI API key
TYPESAFE_API_KEY=                      # Bitwarden: TypeSafe (Jev) API key
LLM_MODEL_CHAT=
LLM_MODEL_FAST=
OTEL_EXPORTER_OTLP_ENDPOINT=           # Dash0 OTLP endpoint (us-west-2)
OTEL_EXPORTER_OTLP_HEADERS=            # Authorization=Bearer <Dash0 auth token>
OTEL_SERVICE_NAME=lanyard-api
DASH0_RUM_AUTH_TOKEN=                  # Bitwarden: Dash0 RUM token
DASH0_RUM_ENDPOINT=
TOKEN_SIGNING_KEY=                     # any long random string
