{
  "name": "@lanyard/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node dist/main.js"
  },
  "tsup": {
    "entry": [
      "src/main.ts"
    ],
    "format": [
      "cjs"
    ],
    "target": "node22",
    "platform": "node",
    "sourcemap": true,
    "clean": true,
    "noExternal": [
      "@lanyard/contracts"
    ]
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "@lanyard/contracts": "*",
    "fastify": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
