{
  "name": "@lanyard/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "PORT=8081 ROLE=worker tsx watch src/main.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test src/**/*.test.ts",
    "start": "node dist/main.js"
  },
  "tsup": {
    "entry": [
      "src/main.ts"
    ],
    "format": [
      "cjs"
    ],
    "target": "node22",
    "platform": "node",
    "sourcemap": true,
    "clean": true,
    "noExternal": [
      "@lanyard/contracts"
    ]
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@lanyard/contracts": "*",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@typesafe-ai/sdk": "^0.7.0",
    "fastify": "^5.0.0",
    "ioredis": "^6.0.0",
    "openai": "^7.54.0",
    "pino": "^10.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  }
}
