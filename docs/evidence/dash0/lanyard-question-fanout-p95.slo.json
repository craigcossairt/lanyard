{
  "apiVersion": "openslo/v1",
  "kind": "SLO",
  "metadata": {
    "name": "lanyard-question-fanout-p95",
    "labels": {
      "team": "lanyard",
      "slo": "question-fanout"
    },
    "annotations": {
      "dash0.com/display-name": "Lanyard: question fanout under 1 s"
    }
  },
  "spec": {
    "description": "95% of question fanouts reach the speaker within 1000 ms (conf.realtime.fanout_ms, native histogram), i.e. p95 < 1 s.",
    "service": "lanyard-app",
    "budgetingMethod": "Occurrences",
    "timeWindow": [
      {
        "duration": "28d",
        "isRolling": true
      }
    ],
    "indicator": {
      "metadata": {
        "name": "question-fanout-under-1s"
      },
      "spec": {
        "ratioMetric": {
          "counter": false,
          "good": {
            "metricSource": {
              "type": "Prometheus",
              "spec": {
                "query": "histogram_fraction(0, 1000, increase({otel_metric_name=\"conf.realtime.fanout_ms\"}[5m])) * histogram_count(increase({otel_metric_name=\"conf.realtime.fanout_ms\"}[5m]))"
              }
            }
          },
          "total": {
            "metricSource": {
              "type": "Prometheus",
              "spec": {
                "query": "histogram_count(increase({otel_metric_name=\"conf.realtime.fanout_ms\"}[5m]))"
              }
            }
          }
        }
      }
    },
    "objectives": [
      {
        "displayName": "p95 fanout < 1 s",
        "target": 0.95
      }
    ]
  }
}
