{
  "name": "lanyard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lanyard: live conference companion (Cloud Native Hackathon 2026)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contracts",
    "apps/api",
    "apps/worker",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c blue,magenta,green \"npm run dev -w apps/api\" \"npm run dev -w apps/worker\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web -w apps/api -w apps/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "start": "node apps/api/dist/main.js",
    "mint-link": "tsx apps/api/src/core/cli/mint-link.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
